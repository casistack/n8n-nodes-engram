{
    "compilerOptions": {
      "strict": true,
      "module": "commonjs",
      "moduleResolution": "node",
      "target": "es2019",
      "outDir": "./dist",
      "rootDir": "./src",
      "types": ["node"],
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "removeComments": true,
      "sourceMap": true,
      "declaration": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules/**/*", "**/*.spec.ts"]
  }